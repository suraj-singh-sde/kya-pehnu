# Copy to .env (git-ignored) and fill in. `docker compose` reads it from this folder.
#   cp .env.example .env

# --- Required ---
# Password of the Valkey that holds sign-in sessions. Generate one:  openssl rand -hex 32
KYAPEHNU_VALKEY_PASSWORD=

# Google sign-in, only to share the app with other people online (README, "Create the Google OAuth client").
# On your own computer leave these empty: the sign-in page asks for an email only (KYAPEHNU_DEV_LOGIN=1, the default).
KYAPEHNU_GOOGLE_CLIENT_ID=
KYAPEHNU_GOOGLE_CLIENT_SECRET=

# --- Optional ---
# KYAPEHNU_DEV_LOGIN=1  (set 0 with a public URL + Google values)
# The port on this computer (127.0.0.1 only) and the address people type in the browser. They must match the
# redirect URI registered with Google: <KYAPEHNU_PUBLIC_URL>/api/auth/google/callback
KYAPEHNU_PORT=8080
# KYAPEHNU_PUBLIC_URL=http://localhost:8080

# BRING YOUR OWN KEY: the AI key is yours. Nothing ships with one. Easiest: leave the provider below empty and paste
# your key in the app (Settings, AI provider). Or set it here and it applies to everyone on this instance.
# Most people leave the AI provider below empty and choose it in the app (Settings, AI provider; the admin only).
# A value set here takes priority and makes that form read-only.
# Which LLM does photo tagging: anthropic | openai_compatible
KYAPEHNU_LLM_PROVIDER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
KYAPEHNU_ANTHROPIC_MODEL=

# --- Any OpenAI-compatible server (Ollama, OpenAI, Gemini, OpenRouter, LM Studio) ---
# Ollama on this computer, seen from the container (Docker Desktop):  base_url http://host.docker.internal:11434/v1,
#                                                                      key "ollama", model qwen2.5vl:7b
# OpenRouter:            base_url https://openrouter.ai/api/v1, key sk-or-..., model e.g. google/gemini-2.5-flash
KYAPEHNU_OPENAI_BASE_URL=
KYAPEHNU_OPENAI_API_KEY=
KYAPEHNU_OPENAI_MODEL=

# --- Pictures on S3 (optional; leave empty to keep them on this computer's disk) ---
# The bucket that holds the pictures. The server reaches it through its AWS instance role: never put an AWS key here.
KYAPEHNU_FILES_BUCKET=
# The bucket's region (default ap-south-1).
KYAPEHNU_FILES_REGION=
# The startup clean-up of stray pictures deletes nothing when it would delete more than this many (default 500).
KYAPEHNU_SWEEP_MAX_DELETES=

# Time zone of the wearers (the chat's "today" and "local time"; a festival is by night from 17:00 local).
# TZ=Asia/Kolkata
